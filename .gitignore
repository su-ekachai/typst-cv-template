# Generated output (PDFs, preview/PNG renders, etc.) — keep the dir, not its contents
output/*
!output/.gitkeep

# Personal data (copy *.example.toml → *.toml and fill in your info)
# Ignore real data at any depth; keep only the committed examples.
data/**/*.toml
!data/*.example.toml

# Personal images (signature, scans, etc.) — keep the dir, ignore its contents
assets/images/*
!assets/images/.gitkeep

# Local files
local/

# Claude Code local settings
.claude/

# Typst cache
.typst/

# OS files
.DS_Store
Thumbs.db

# Editor files
.idea/
.vscode/
*.swp
*.swo
*~
